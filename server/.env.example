# ---- Database (Database module owns this URL format; DevOps/backend fills in real values) ----
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/wealthmap"

# ---- Auth ----
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ---- AI Layer ----
LLM_API_KEY="replace-with-openai-or-gemini-key"
LLM_PROVIDER="openai"

# ---- Server ----
PORT=5000
NODE_ENV="development"
