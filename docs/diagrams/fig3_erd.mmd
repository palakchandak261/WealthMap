erDiagram
    USERS ||--o{ INCOMES : "earns"
    USERS ||--o{ EXPENSES : "spends"
    USERS ||--o{ BUDGETS : "defines"
    BUDGETS ||--|{ CATEGORY_BUDGETS : "allocates"
    USERS ||--o{ OBLIGATIONS : "commits_to"
    USERS ||--o{ GOALS : "aims_for"
    USERS ||--o{ PREDICTIONS : "receives"
    USERS ||--o{ RISK_LOGS : "logs"
    USERS ||--o{ GRAPH_NODES : "owns"
    GRAPH_NODES ||--o{ GRAPH_EDGES : "source_node"
